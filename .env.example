# Copy to .env and adjust. All settings are also readable from the environment.

# PostgreSQL connection string (asyncpg DSN).
MECLOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mec_cast_logs

# Connection pool sizing.
MECLOG_DB_POOL_MIN_SIZE=1
MECLOG_DB_POOL_MAX_SIZE=10
MECLOG_DB_COMMAND_TIMEOUT=30.0

# Apply pending migrations automatically on startup.
MECLOG_AUTO_MIGRATE=true

# Ingestion limits.
MECLOG_MAX_BATCH_SIZE=500
MECLOG_MAX_MESSAGE_LENGTH=65536

# Query paging.
MECLOG_DEFAULT_PAGE_SIZE=100
MECLOG_MAX_PAGE_SIZE=1000

# Default window kept by `mec-cast-logs purge`.
MECLOG_RETENTION_DAYS=30

# Service log verbosity (the service's own logs, not ingested ones).
MECLOG_LOG_LEVEL=INFO
